[mysqld]

# BASIC SERVER SETTINGS
user                    = mysql
port                    = 3306
bind-address            = 0.0.0.0
default-time-zone       = +08:00
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci
max_connections         = 200
performance_schema      = ON


# DATA / LOG DIRECTORIES
datadir                 = /data/mysql/data
log-error               = /data/mysql/logs/mariadb-error.log
pid-file                = /run/mysqld/mysqld.pid
socket                  = /run/mysqld/mysqld.sock


# BINARY LOGGING
log_bin                 = /data/mysql/binlog/mysql-bin
binlog_format           = ROW
binlog_expire_logs_seconds = 604800
max_binlog_size         = 100M


# REPLICATION
server_id               = 1101  # Must be different for each node in the replica set
gtid_strict_mode        = ON
gtid_domain_id          = 1100  # Must be the same for each node in the replica set
log_slave_updates       = ON
relay_log               = /data/mysql/relaylog/relay-bin
relay_log_index         = /data/mysql/relaylog/relay-bin.index


# REPLICATION SAFETY
read_only               = ON
relay_log_recovery      = ON


# INNODB


default_storage_engine  = InnoDB
innodb_buffer_pool_size = 256M
innodb_log_file_size    = 256M
innodb_file_per_table   = ON
innodb_flush_log_at_trx_commit = 1
sync_binlog             = 1


# SQL / SAFETY
sql_mode                = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
skip_name_resolve       = ON


# CONNECTION / NETWORK
max_allowed_packet      = 64M
wait_timeout            = 28800
interactive_timeout     = 28800


# SLOW QUERY LOG
slow_query_log          = ON
slow_query_log_file     = /data/mysql/logs/mariadb-slow.log
long_query_time         = 1


[client]

port                    = 3306
socket                  = /run/mysqld/mysqld.sock
default-character-set   = utf8mb4
